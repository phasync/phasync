{
    "name": "phasync/benchmarks",
    "description": "Cross-runtime benchmarks: phasync vs Amp vs ReactPHP",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {"type": "path", "url": "..", "options": {"symlink": true}}
    ],
    "require": {
        "php": ">=8.1",
        "phasync/phasync": "@dev",
        "amphp/amp": "*",
        "amphp/socket": "*",
        "amphp/http-client": "*",
        "revolt/event-loop": "*",
        "react/event-loop": "*",
        "react/promise": "*",
        "react/socket": "*",
        "react/http": "*",
        "react/async": "*"
    }
}
